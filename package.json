{
  "private": true,
  "name": "here-lies-game",
  "version": "0.1.0",
  "description": "A daily haunted-crypt deduction game for Reddit where the dead light the way",
  "license": "Apache-2.0",
  "author": "Safal Mutha",
  "repository": {
    "type": "git",
    "url": "https://github.com/muthasafal/here-lies.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --build",
    "test:unit": "vitest run",
    "sweep": "tsx tools/scripts/sweep.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.6",
    "@devvit/web": "0.15.6",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.6",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "^4.3.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "^4.0.0"
  }
}
